# URL da aplicação do SuiteOps
PUBLIC_APP_URL=https://app.suiteops.com.br

# URL pública do site
PUBLIC_SITE_URL=https://www.suiteops.com.br

# Contato e conversão
PUBLIC_WHATSAPP_URL=https://wa.me/5511999999999?text=Ol%C3%A1%2C%20gostaria%20de%20conhecer%20o%20SuiteOps
PUBLIC_CONTACT_EMAIL=contato@suiteops.com.br

# --- Entrega do formulário ao SuiteOps -------------------------------------
# A rota /api/lead assina o corpo com HMAC-SHA256 e entrega ao app. Estas três
# NÃO levam o prefixo PUBLIC_ de propósito: no Astro, PUBLIC_* é embutido no
# bundle do navegador, e o segredo no navegador deixa qualquer um cadastrar
# lead em nome da unidade.
#
# O segredo é o `form_secret` da unidade, revelado em Configurações > Unidades
# de negócio, no app. Regerá-lo lá derruba o formulário até atualizar aqui.
# Unidade e segredo precisam ser do MESMO par: o app busca a unidade pelo uuid
# e confere a assinatura contra o segredo dela — trocado, a resposta é a mesma
# de uuid inexistente ("Assinatura inválida"), o que engana na hora de depurar.
SUITEOPS_UNIT_UUID=
SUITEOPS_FORM_SECRET=

# O funil de destino. Vazio, o app usa o funil de pré-venda padrão da unidade.
SUITEOPS_PIPELINE_UUID=

# Para onde a rota entrega. Vazio, cai no PUBLIC_APP_URL.
SUITEOPS_APP_URL=
